# Cloudflare response headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# The /* block must match PAGE_HEADERS in server/securityHeaders.ts, which says
# what the Content-Security-Policy allows and why (a test checks they match).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-zs6CEk6eruKJk2HsKt7c4j4FYl/Gw9upI96z5q43czM=' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: blob:; connect-src 'self' https: data: blob:; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable
